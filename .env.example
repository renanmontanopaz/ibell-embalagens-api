# .env.example
# Arquivo de exemplo de variáveis de ambiente.
# Crie um arquivo .env real com os valores corretos e NÃO o adicione ao Git.

# Banco de Dados PostgreSQL
POSTGRES_DB=ibell-embalagens
POSTGRES_USER=postgres
POSTGRES_PASSWORD= # Deixe vazio ou coloque <sua_senha_aqui>

# Backend Spring Boot Datasource
# Geralmente podem ser derivados das variáveis do Postgres acima no .env real
SPRING_DATASOURCE_USER=${POSTGRES_USER}
SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD}
SPRING_DATASOURCE_DB=${POSTGRES_DB}

# Outras variáveis do Spring Boot (se houver)
# EXEMPLO_VARIAVEL=valor_padrao_ou_deixe_vazio